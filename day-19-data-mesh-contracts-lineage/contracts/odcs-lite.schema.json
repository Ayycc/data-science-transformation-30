{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ayycc/data-science-transformation-30/day-19/odcs-lite.schema.json",
  "title": "ODCS-lite data contract",
  "description": "A strict subset of the Open Data Contract Standard (ODCS) v3 fields used by this project: identity, ownership, semantic version, schema, SLAs, server and dual-publishing metadata.",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "name", "version", "status", "domain", "dataProduct", "contractCreatedTs", "team", "schema", "slaProperties", "servers"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"type": "string", "pattern": "^v3\\.[0-9]+\\.[0-9]+$"},
    "kind": {"const": "DataContract"},
    "id": {"type": "string", "pattern": "^urn:datacontract:[a-z_]+:[a-z_]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"enum": ["draft", "active", "deprecated", "retired"]},
    "domain": {"type": "string"},
    "dataProduct": {"type": "string"},
    "tenant": {"type": "string"},
    "contractCreatedTs": {"type": "string", "format": "date-time"},
    "description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"purpose": {"type": "string"}, "usage": {"type": "string"}, "limitations": {"type": "string"}}
    },
    "team": {
      "type": "object",
      "required": ["name", "members"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["username", "role"],
            "additionalProperties": false,
            "properties": {"username": {"type": "string"}, "role": {"enum": ["owner", "steward", "engineer", "consumer-liaison"]}}
          },
          "contains": {"properties": {"role": {"const": "owner"}}}
        }
      }
    },
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "physicalName", "physicalType", "properties"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z_]+$"},
          "physicalName": {"type": "string", "pattern": "^[a-z_]+_v[0-9]+$"},
          "physicalType": {"enum": ["table", "view"]},
          "description": {"type": "string"},
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "logicalType", "physicalType", "required"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z_]+$"},
                "logicalType": {"enum": ["string", "integer", "number", "boolean", "date", "timestamp"]},
                "physicalType": {"type": "string", "pattern": "^(varchar|integer|bigint|boolean|date|timestamp|double|decimal\\([0-9]+,[0-9]+\\))$"},
                "required": {"type": "boolean"},
                "unique": {"type": "boolean"},
                "primaryKey": {"type": "boolean"},
                "description": {"type": "string"},
                "classification": {"enum": ["public", "internal", "pii"]},
                "logicalTypeOptions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"enum": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}
                }
              }
            }
          }
        }
      }
    },
    "slaProperties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["property", "value", "unit"],
        "additionalProperties": false,
        "properties": {
          "property": {"enum": ["freshness", "completeness", "uniqueness", "volume"]},
          "value": {"type": "number"},
          "unit": {"enum": ["h", "percent", "rows"]},
          "element": {"type": "string"}
        }
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["server", "type", "database", "schema"],
        "additionalProperties": false,
        "properties": {"server": {"type": "string"}, "type": {"const": "duckdb"}, "database": {"type": "string"}, "schema": {"type": "string"}}
      }
    },
    "customProperties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "value"],
        "additionalProperties": false,
        "properties": {
          "property": {"enum": ["dualPublish"]},
          "value": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "physicalName", "deprecationDate"],
              "additionalProperties": false,
              "properties": {
                "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "physicalName": {"type": "string"},
                "deprecationDate": {"type": "string", "format": "date"}
              }
            }
          }
        }
      }
    }
  }
}
